# Copiar como .env.local (local) o cargar en Vercel → Settings → Environment Variables.
# Sin estas variables la app usa archivos locales (data/) o, en Vercel, modo demostración.
SUPABASE_URL=https://nqqvwrcsznjqkayqacve.supabase.co
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...). SOLO servidor: nunca en el navegador ni en git.
SUPABASE_SECRET_KEY=
# Solo para scripts/supabase.js esquema: Account → Access Tokens (sbp_...). No lo necesita la app.
SUPABASE_ACCESS_TOKEN=

# Inicio de sesión (obligatorio en Vercel; en local se activa si ambas existen)
APP_USUARIO=
APP_CLAVE=
# Opcional: clave para firmar la cookie de sesión (si no, se deriva de APP_CLAVE)
SESION_SECRETO=
